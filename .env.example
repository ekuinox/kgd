# cloudflared コンテナに渡すグループ ID。
# ホスト側で cloudflared/ ディレクトリを所有するグループの GID に合わせる
# (`stat -c '%g' cloudflared` で確認できる)。コンテナは既定の nonroot ユーザー
# (65532) のまま動き、このグループ経由で設定と認証情報を読む。認証情報を
# 世界読み取り可にせず、root でも動かさないための指定。
#
# このファイルを .env としてコピーして使う (.env は git 管理外)。
# トンネルを使わない場合は tunnel プロファイルを起動しなければよく、
# その場合この値は不要。
CLOUDFLARED_GID=1000
